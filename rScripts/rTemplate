# --- Script activation flags ---
enable = True
useInitialize = False
useHold = False
useTick = False
# --- Imports ---
import os
from pathlib import Path
from forms.utils.rScripts import (
    rTaskRegister, rTaskStart, rTaskRunning, rTaskStop, RScriptControl
)
from formslab.state import CAST_STATE_PATH
# --- Constants ---
name = os.path.splitext(os.path.basename(__file__))[0]
CASTPATH = CAST_STATE_PATH

# --- Encapsulated State ---
class rGlobal:
    useInitialize = useInitialize
    useHold = useHold
    useTick = useTick
    TICK_INTERVAL = 10.0
    HOLD_DURATION = 3
# --- rScript Entry Point ---
def rScript(forms):
    if not enable:
        return

    # === Refactored execution control ===
    r = RScriptControl(forms,name)
    if rGlobal.useInitialize: r.initialize()
    if rGlobal.useHold:       r.hold(iterations=rGlobal.HOLD_DURATION)
    if rGlobal.useTick:       r.tick(seconds=rGlobal.TICK_INTERVAL)

